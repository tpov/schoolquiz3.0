<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_dark"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Modern Header Card with Daily Progress -->
        <LinearLayout
            android:id="@+id/cv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/top_panel_background"
            android:elevation="4dp"
                android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/boxDay1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay3"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay4"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay5"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay6"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay7"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay8"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay9"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                    <View
                        android:id="@+id/boxDay10"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/progress_bar_inactive"
                        android:alpha="0.5" />

                </LinearLayout>

                <!-- Top Row: Menu + User + Premium -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:id="@+id/imb_manu"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_button_background"
                        android:src="@drawable/baseline_more_vert"
                        android:padding="6dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="User177"
                        android:textColor="@color/app_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/circle_button_background"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tv_count_premiun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="999"
                            android:textColor="@color/gold"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:id="@+id/imv_premiun"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/premium_ic" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Stats Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <!-- Stars -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_stars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/gold"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:id="@+id/imv_stars"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/star_full" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_nolics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="999 999"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:id="@+id/imv_nolics"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_monetization_on_24" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/pb_life1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_favorite_24"
                            android:layout_marginEnd="2dp" />

                        <ImageView
                            android:id="@+id/pb_life2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_favorite_24"
                            android:layout_marginEnd="2dp" />

                        <ImageView
                            android:id="@+id/pb_life3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_favorite_24"
                            android:layout_marginEnd="2dp" />

                        <ImageView
                            android:id="@+id/pb_life4"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_favorite_24"
                            android:layout_marginEnd="2dp" />

                        <ImageView
                            android:id="@+id/pb_life5"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_favorite_24"
                            android:layout_marginEnd="2dp" />

                        <ImageView
                            android:id="@+id/pb_life_gold1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_favorite_24_gold" />

                    </LinearLayout>

                    <!-- Gold -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_gold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/gold"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:id="@+id/imv_gold"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_gold" />

                    </LinearLayout>
                </LinearLayout>

        </LinearLayout>

        <!-- Fragment Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/title_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="85dp"
            android:layout_marginBottom="70dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Floating Action Buttons -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp">

            <!-- Box FAB -->
            <androidx.cardview.widget.CardView
                android:id="@+id/fab_box"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="75dp"
                android:backgroundTint="@color/button_fab_default"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_box"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/ic_box"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_number_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_button_background"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- Add FAB -->
            <androidx.cardview.widget.CardView
                android:id="@+id/fab_add_item"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="80dp"
                android:backgroundTint="@color/button_fab_primary"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imv_add_item"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/ic_baseline_add_circle_24"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_number_place_user_quiz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_button_background"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:text=""
                        android:textColor="@color/app_success"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- Search FAB -->
            <androidx.cardview.widget.CardView
                android:id="@+id/fab_search"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:backgroundTint="@color/button_fab_secondary"
                app:cardCornerRadius="28dp"
                android:layout_marginBottom="75dp"
                app:cardElevation="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/ic_search"
                    app:tint="@android:color/white" />

            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- Fixed Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bottom_nav_background"
            android:elevation="8dp"
            android:orientation="vertical">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:itemIconSize="24dp"
                app:itemIconTint="@android:color/white"
                app:itemTextColor="@android:color/white"
                app:labelVisibilityMode="unlabeled"
                app:menu="@menu/menu_title_activity" />

        </LinearLayout>

        <!-- Progress Section - фиксированная позиция -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_pb_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="sync profile"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressBar2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:visibility="visible" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Modern Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/navigation_background"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white" />

</androidx.drawerlayout.widget.DrawerLayout>
