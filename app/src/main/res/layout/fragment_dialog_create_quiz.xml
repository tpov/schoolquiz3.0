<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_main">

    <LinearLayout
        android:id="@+id/ll_create_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteX="65dp">

        <com.tpov.schoolquiz.presentation.custom.CustomSpinner
            android:id="@+id/sp_create_category"
            android:layout_width="100dp"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/tv_create_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Category" />


    </LinearLayout>

    <include
        android:id="@+id/categoryItem"
        layout="@layout/activity_quiz_item"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/ll_create_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_create_sub_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/categoryItem"
        android:layout_margin="16dp">

        <com.tpov.schoolquiz.presentation.custom.CustomSpinner
            android:id="@+id/sp_create_sub_category"
            android:layout_width="100dp"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/tv_create_sub_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Quiz name" />

    </LinearLayout>

    <include
        android:id="@+id/subCategoryItem"
        layout="@layout/activity_quiz_item"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/ll_create_sub_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_create_subsub_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/subCategoryItem"
        android:layout_margin="16dp">

        <com.tpov.schoolquiz.presentation.custom.CustomSpinner
            android:id="@+id/sp_create_subsub_category"
            android:layout_width="100dp"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/tv_create_subsub_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Theme name" />

    </LinearLayout>

    <include
        android:id="@+id/subSubCategoryItem"
        layout="@layout/activity_quiz_item"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/ll_create_subsub_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_create_quest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/subSubCategoryItem"
        android:layout_margin="16dp">

        <com.tpov.schoolquiz.presentation.custom.CustomSpinner
            android:id="@+id/sp_create_quest"
            android:layout_width="100dp"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/tv_create_quest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Quest name" />

    </LinearLayout>


    <include
        android:id="@+id/currentQuizItem"
        layout="@layout/activity_quiz_item"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/ll_create_quest"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Отмена"
            android:background="@drawable/back_item_main_false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Сохранить"
            android:background="@drawable/back_item_main_true"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_type_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/llButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/b_light_question"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/back_item_main_true"
            android:text="Легкие вопросы"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/b_hard_question"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/back_item_main_false"
            android:text="Сложные вопросы"
            android:textColor="@color/white" />
    </LinearLayout>

    <com.tpov.schoolquiz.presentation.custom.CustomSpinner
        android:id="@+id/sp_language_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/ll_type_question"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
