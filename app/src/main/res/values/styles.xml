<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomTheme" parent="Theme.AppCompat">
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:colorPrimary">@color/white</item>
        <item name="android:colorPrimaryDark">@color/white</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:background">#FFFFFF</item>
    </style>
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/back_main_top</item>
    </style>

    <!-- styles.xml -->
    <style name="DialogAnimationCreateQuestion">
        <item name="android:windowEnterAnimation">@anim/slide_in_horizontal</item>
        <item name="android:windowExitAnimation">@anim/slide_out_vertical</item>
    </style>

    <style name="BottomRoundedShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">25dp</item>
        <item name="cornerSizeBottomRight">25dp</item>
    </style>

    <style name="CustomSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:popupBackground">@color/colorPrimary</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTintMode">src_in</item>
    </style>

    <style name="CustomSpinnerItemStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SpinnerTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:dropDownListViewStyle">@style/SpinnerDropDownStyle</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <style name="SpinnerDropDownStyle" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@color/spinner_dropdown_background</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:background">@color/spinner_dropdown_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/spinner_dropdown_background</item>
    </style>

</resources>
