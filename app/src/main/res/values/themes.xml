<resources>
    <!-- Base application theme. -->
    <style name="Theme.GeoQuiz" parent="Theme.AppCompat.Light">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Primary brand color. -->
        <!-- Secondary brand color. -->
        <item name="android:fontFamily">@font/cutive_mono</item>
        <item name="android:colorPrimary">@color/white</item>
        <item name="android:colorPrimaryDark">@color/back_main_top</item> //Цвет статуса бара - теперь самый темный
        <item name="android:colorAccent">#FFFFFF</item>    //текст
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="colorControlHighlight">#66FF0000</item> //Волновой єффект єлемента меню
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <!-- Secondary brand color. -->

        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    
    <!-- Enhanced Action Bar with layering -->
    <style name="MyActionBar" parent="@style/Widget.AppCompat.ActionBar">
        <item name="android:colorPrimaryDark">#FFFFFF</item>
        <item name="android:colorPrimary">#FFFFFF</item>
        <item name="android:background">@color/app_toolbar_background</item>
    </style>

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="colorControlNormal">@color/star_outline</item>
    </style>
    <style name="RatingBarFavorite" parent="Theme.AppCompat">
        <item name="android:colorControlActivated">#FF0000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="colorControlNormal">#737373</item>
    </style>
    <style name="RatingBarFavoriteGold" parent="Theme.AppCompat">
        <item name="android:progressDrawable">@drawable/rating_full</item>
        <item name="android:indeterminateDrawable">@drawable/rating_full</item>
    </style>
    
    <!-- Enhanced App Theme with layered design -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="colorControlNormal">@color/app_toolbar_background</item>

        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Enhanced theme with better status bar handling -->
    <style name="Theme.GeoQuiz.NoActionBar.DarkStatusBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/app_background_dark</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Стиль текста в терминале -->
    <style name="TerminalText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Стиль фона в терминале -->
    <style name="TerminalBackground">
        <item name="android:background">#000000</item>
    </style>
</resources>