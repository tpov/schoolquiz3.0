{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "NOIR — інженерна темна дизайн-система",
  "version": "2.0.0",
  "description": "Один токен-скелет на чистому чорному + 3 скіни акценту + рольова система ефектів. Всі текстові пари проходять WCAG AA (>= 4.5:1). Ефект — це роль, не декор.",
  "color": {
    "bg":            { "$type": "color", "$value": "#000000", "oklch": "oklch(0.000 0.000 0)",     "role": "Фон застосунку (OLED-чорний)" },
    "surface-1":     { "$type": "color", "$value": "#1E1E24", "oklch": "oklch(0.238 0.011 285)",  "role": "Картка (помітний острів на чорному)" },
    "surface-2":     { "$type": "color", "$value": "#26262E", "oklch": "oklch(0.272 0.015 285)",  "role": "Піднята поверхня 2" },
    "surface-3":     { "$type": "color", "$value": "#2E2E36", "oklch": "oklch(0.304 0.014 286)",  "role": "Піднята картка / бар" },
    "surface-4":     { "$type": "color", "$value": "#383840", "oklch": "oklch(0.344 0.014 286)",  "role": "Діалог / bottom sheet" },
    "outline":       { "$type": "color", "$value": "#44444E", "oklch": "oklch(0.390 0.017 286)",  "role": "Обводка (було #2C2C2C — невидима 1.1:1)" },
    "outline-strong":{ "$type": "color", "$value": "#5E5E6A", "oklch": "oklch(0.486 0.019 286)",  "role": "Обводка активна / фокус" },
    "text-1":        { "$type": "color", "$value": "#FFFFFF", "oklch": "oklch(1.000 0 0)",        "role": "Заголовки (16.6:1 на surface-1)" },
    "text-2":        { "$type": "color", "$value": "#B8B8B8", "oklch": "oklch(0.783 0 0)",        "role": "Основний текст (8.4:1 на surface-1, 6.8:1 на surface-3)" },
    "text-3":        { "$type": "color", "$value": "#9C9CA6", "oklch": "oklch(0.696 0.014 286)",  "role": "Другорядний (6.1:1 на surface-1, 4.95:1 на surface-3)" },
    "text-disabled": { "$type": "color", "$value": "#6E6E78", "oklch": "oklch(0.560 0.012 286)",  "role": "Лише неактивні стани (виняток WCAG)" },
    "ink-on-accent": { "$type": "color", "$value": "#05090F", "oklch": "oklch(0.120 0.02 250)",   "role": "Текст на яскравих кнопках" }
  },
  "accent": {
    "$comment": "Скіни на одному скелеті. Hue зсунуто від Google Blue (oklch h=260), енергія збережена (L≈0.66, C≈0.16).",
    "azure":    { "$type": "color", "$value": "#0599EF", "oklch": "oklch(0.660 0.165 245)", "contrast": { "on-bg": 6.8, "on-surface-3": 5.0, "ink-on-it": 6.5 }, "default": true },
    "amethyst": { "$type": "color", "$value": "#9680F2", "oklch": "oklch(0.670 0.165 290)", "contrast": { "on-bg": 6.7, "on-surface-3": 4.9, "ink-on-it": 6.3 } },
    "teal":     { "$type": "color", "$value": "#00AFAF", "oklch": "oklch(0.680 0.120 195)", "contrast": { "on-bg": 7.8, "on-surface-3": 5.7, "ink-on-it": 7.4 } }
  },
  "status": {
    "gold":    { "$type": "color", "$value": "#FFD700", "oklch": "oklch(0.887 0.182 95)",  "role": "Pro / преміум (11:1 — залишено як є)" },
    "success": { "$type": "color", "$value": "#5CC97A", "oklch": "oklch(0.752 0.152 150)", "role": "Успіх / легкий режим (7.4:1; було #4CAF50 — вирівняно L)" },
    "danger":  { "$type": "color", "$value": "#F0564B", "oklch": "oklch(0.658 0.191 28)",  "role": "Помилка / складний режим (4.5:1 AA; було #E53935 — 3.65:1)" },
    "violet":  { "$type": "color", "$value": "#9680F2", "oklch": "oklch(0.670 0.165 290)", "role": "Лімітоване / сезонне. Константа, не залежить від скіна" }
  },
  "fx": {
    "$comment": "Рольова система ефектів. Кожен ефект має ОДНУ роль і з'являється рідко — інакше це декор.",
    "gold-ring":   { "border": "1px solid gold × 55%", "shadow": "0 0 24px gold × 14%", "role": "Тільки Pro / преміум-елементи" },
    "gold-sheen":  { "animation": "sheen 7s, пауза ≥ 70% циклу", "role": "Одна Pro-картка на екран" },
    "violet-ring": { "border": "1px solid violet × 55%", "shadow": "0 0 20px violet × 12%", "role": "Тільки лімітоване / сезонне" },
    "accent-glow": { "shadow": "0 0 18px accent × 38%", "role": "Hover/focus основної дії, активні стани" },
    "glow-arena":  { "background": "radial accent × 16% поверх #000", "role": "Екран гри: режим арена" },
    "glow-easy":   { "background": "radial success × 16% поверх #000", "role": "Екран гри: легкий режим" },
    "glow-hard":   { "background": "radial danger × 16% поверх #000", "role": "Екран гри: складний режим" },
    "top-light":   { "shadow": "inset 0 1px 0 rgba(255,255,255,0.045)", "role": "'Зафрезерована' кромка карток — скрізь" }
  },
  "spacing": { "unit": 4, "scale": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 } },
  "radius":  { "chrome": 8, "sm": 8, "md": 12, "lg": 16, "xl": 20, "pill": 999, "$comment": "Картки 16 (м'який legacy-вигляд), діалоги/sheet 20" },
  "typography": {
    "family": {
      "display": "Archivo variable, wdth 112, 600–700, uppercase, tracking +0.06…+0.22em",
      "body": "system-ui / Roboto 400–500",
      "mono": "JetBrains Mono 400–700 — числа, ціни, таймери, кікери (uppercase, tracking +0.2em)"
    },
    "scale": {
      "display":  { "size": 28, "weight": 700, "lineHeight": 1.15 },
      "title":    { "size": 20, "weight": 600, "lineHeight": 1.2 },
      "headline": { "size": 16, "weight": 600, "lineHeight": 1.3 },
      "body":     { "size": 14, "weight": 400, "lineHeight": 1.5 },
      "caption":  { "size": 12, "weight": 500, "lineHeight": 1.35 },
      "mono":     { "size": 13, "weight": 600, "note": "Числа, таймери, ціни" }
    }
  },
  "elevation": {
    "$comment": "На чистому чорному тінь невидима — elevation = світліша поверхня (surface-1..4), тінь лише для sheet/dialog.",
    "level-0": "bg", "level-1": "surface-1", "level-2": "surface-2", "level-3": "surface-3", "level-4": "surface-4"
  },
  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 280 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasis": "cubic-bezier(0.2, 0.7, 0.3, 1.15)" }
  }
}
