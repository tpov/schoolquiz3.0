diff --git a/platform/firebase/src/test/kotlin/com/tpov/schoolquiz/platform/firebase/arena/ServerWindowContractBindingTest.kt b/platform/firebase/src/test/kotlin/com/tpov/schoolquiz/platform/firebase/arena/ServerWindowContractBindingTest.kt
