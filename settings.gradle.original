include ':app'
rootProject.name = "schoolquiz"
include ':settings'
include ':common'
include ':shop'
include ':userguide'
include ':network'
include ':log-api'
include ':core'
include ':logger-compiler-plugin'
// Удаляем logger-gradle-plugin из основного проекта, чтобы использовать его как внешнюю зависимость
// из локального Maven репозитория (опубликованную через publishToMavenLocal)

// Включаем сборку плагина для его использования непосредственно из исходных файлов
//includeBuild('logger-gradle-plugin') {
    dependencySubstitution {
        // При запросе артефакта будет использоваться проект
        substitute(module('com.tpov.logger:logger-gradle-plugin')).using(project(':'))
    }
}
