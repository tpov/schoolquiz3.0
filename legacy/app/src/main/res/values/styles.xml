<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomTheme" parent="Theme.AppCompat">
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:colorPrimary">@color/white</item>
        <item name="android:colorPrimaryDark">@color/white</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:background">#FFFFFF</item>
    </style>
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/back_main_top</item>
    </style>

    <!-- styles.xml -->
    <style name="DialogAnimationCreateQuestion">
        <item name="android:windowEnterAnimation">@anim/slide_in_horizontal</item>
        <item name="android:windowExitAnimation">@anim/slide_out_vertical</item>
    </style>

    <style name="BottomRoundedShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">25dp</item>
        <item name="cornerSizeBottomRight">25dp</item>
    </style>

    <style name="CustomSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:popupBackground">@color/colorPrimary</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTintMode">src_in</item>
    </style>

    <style name="CustomSpinnerItemStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SpinnerTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:dropDownListViewStyle">@style/SpinnerDropDownStyle</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <style name="SpinnerDropDownStyle" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@color/spinner_dropdown_background</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:background">@color/spinner_dropdown_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/spinner_dropdown_background</item>
    </style>

    <!-- Enhanced Layered UI Styles -->
    
    <!-- Toolbar with layered design -->
    <style name="LayeredToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@drawable/toolbar_background_layered</item>
        <item name="titleTextColor">@color/app_text_primary</item>
        <item name="subtitleTextColor">@color/app_text_secondary</item>
        <item name="android:elevation">4dp</item>
    </style>
    
    <!-- Card styles with better visual separation -->
    <style name="LayeredCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/app_card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    
    <style name="LayeredCardElevated" parent="LayeredCard">
        <item name="cardBackgroundColor">@color/app_card_elevated</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/active_border</item>
    </style>
    
    <!-- Text styles with hierarchy -->
    <style name="TextPrimary">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <style name="TextSecondary">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="TextTertiary">
        <item name="android:textColor">@color/app_text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>
    
    <!-- Button styles -->
    <style name="LayeredButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/app_accent</item>
        <item name="android:textColor">@color/app_button_text</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="LayeredButtonSecondary" parent="LayeredButton">
        <item name="backgroundTint">@color/app_card_elevated</item>
        <item name="strokeColor">@color/active_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
