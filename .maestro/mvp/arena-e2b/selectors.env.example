# Copy outside the repository after `maestro hierarchy` on the exact retained device + candidate.
# Values intentionally remain blank here: do not infer them from a source string or another locale.
# Each value is passed as one Maestro text/regex selector; never add a newline or shell syntax.

# identity/catalog preflight (account identity is separately checked against the immutable
# owner UID with read-only Firebase evidence; the UI confirms the retained wallet, catalog and price).
E2B_SELECTOR_INTERNET=
E2B_SELECTOR_ARENA_TITLE=
E2B_SELECTOR_REFRESH_BALANCE=
E2B_SELECTOR_NOLICS_BALANCE=
E2B_SELECTOR_LIFE_BALANCE=
E2B_SELECTOR_LOAD_LESSONS=
E2B_SELECTOR_CATALOG_LOADED=
E2B_SELECTOR_TARGET_LESSON=
E2B_SELECTOR_FIXTURE_AUTHOR=
E2B_SELECTOR_FROZEN_PRICE=

# selected HARD preparation
E2B_SELECTOR_SELECTED_PREPARE=
E2B_SELECTOR_PREPARE_DIALOG=
E2B_SELECTOR_DIFFICULTY_HARD=
E2B_SELECTOR_HARD_SELECTED=
E2B_SELECTOR_PREPARE_CONFIRM=
E2B_SELECTOR_PREPARED_TICKET=

# start, persisted answer, and restart
E2B_SELECTOR_SHOW_LOCAL_TICKETS=
# Use the literal placeholder {{ticketId}} exactly once; the runner substitutes the reader-verified ID.
E2B_SELECTOR_TICKET_LABEL_TEMPLATE=
E2B_SELECTOR_TICKET_START=
E2B_SELECTOR_TICKET_OPEN=
E2B_SELECTOR_QUESTION=
E2B_SELECTOR_FIRST_ANSWER=
# Capture the post-answer feedback control, not the selected option text. A HARD question may
# deliberately reveal no verdict or option text; the Room reader proves the saved answer.
E2B_SELECTOR_SAVED_ANSWER=
E2B_SELECTOR_RESUME_DIALOG=
# Regex that accepts either the recovery dialog or the restored feedback control after Open.
E2B_SELECTOR_RESUME_OR_SAVED=
E2B_SELECTOR_RESUME_CONTINUE=
E2B_SELECTOR_SECOND_QUESTION=
E2B_SELECTOR_SECOND_ANSWER=
E2B_SELECTOR_CONTINUE_LESSON=

# Narrow retained-ticket reconciliation. These are literal visible strings for
# `flows/00-recover-one-settled-ticket.yaml`; that flow never prepares or restores a ticket.
E2B_SELECTOR_RECOVER_TICKET=
E2B_SELECTOR_TERMINAL_TICKET=

# completion and rating
E2B_SELECTOR_SYNCHRONIZE=
# Capture the pending status from the result receipt screen. It is not the generic local-outbox
# notice: the next server reader verifies that the same retained SETTLE remains unconfirmed.
E2B_SELECTOR_SETTLE_PENDING=
E2B_SELECTOR_SETTLE_CONFIRMED=
E2B_SELECTOR_RATING_PROMPT=
E2B_SELECTOR_RATE_TWO=
E2B_SELECTOR_RATING_QUEUED=
E2B_SELECTOR_SEND_QUEUED_RATING=
E2B_SELECTOR_RATING_ACCEPTED=
