# Capture these visible-text expressions from the exact retained APK before use.
MATRIX_SELECTOR_HOME=^HOME QUESTS$
MATRIX_SELECTOR_INTERNET=^INTERNET$
MATRIX_SELECTOR_OPEN_MENU=^Open menu$
MATRIX_SELECTOR_ARENA_NAV=^ARENA$
MATRIX_SELECTOR_ARENA_TITLE=^Arena lessons$
MATRIX_SELECTOR_OPEN_CATALOG=^Open lesson catalog$
MATRIX_SELECTOR_CATALOG_PROMPT=^Press Load lessons to request the catalog\.$
MATRIX_SELECTOR_LOAD_LESSONS=^Load lessons$
MATRIX_SELECTOR_LOADED_CATALOG=^Loaded [0-9]+ of [0-9]+ lessons$
MATRIX_SELECTOR_ARENA_ROOT_PREVIEW=^Catalog preview only\. Entry preparation and play are not connected yet\.$
MATRIX_SELECTOR_ARENA_RESERVATIONS=^Arena reservations$
MATRIX_SELECTOR_PREPARE=^Prepare selected lesson$
MATRIX_SELECTOR_CONFIRM_PREPARATION=^Confirm preparation$
MATRIX_SELECTOR_CONFIRM_CANCELLATION=^Confirm cancellation$
MATRIX_SELECTOR_TICKET_LABEL=^Ticket: .+$
MATRIX_SELECTOR_TICKET_STATE=^(?:Prepared locally\. Starting requires a separate validated run\.|Existing run: resume or reconcile; do not restart from zero\.|Cancellation pending\. Funds are not confirmed released\.|Result is waiting for server settlement\.|A terminal server state is saved\. Pending local work may still need reconciliation\.|This record needs server recovery\. Do not create a replacement to resolve it\.)$
MATRIX_SELECTOR_RUNNER_ACTIVE=^(?:Exit lesson|Resume this lesson\?|Continue lesson|Are you sure\? Attempt progress will be lost|Reading the saved attempt…|Saving the final submission…|Submission saved on this device\. Waiting for the server result and accounting receipt\.|Cancellation saved on this device\. The server has not confirmed the release of reserved resources\.|The ticket is settled, but a verified result receipt is still required\.)$
MATRIX_SELECTOR_RECEIPT=^(?:Arena result receipt|Waiting for server confirmation\. Score and rewards are not confirmed yet\.|Completion confirmed by the server|Score and charges confirmed; completion is not confirmed\.|The server saved this attempt without a score\. It is not a zero\.|The server did not accept this attempt\.|Legacy record: no server scoring proof is available\.|Server confirmation could not be verified\. Result is unknown\.)$
MATRIX_SELECTOR_START=^Start this prepared attempt$
MATRIX_SELECTOR_OPEN_SAVED=^Open saved attempt or result$
MATRIX_SELECTOR_SYNCHRONIZE=^Synchronize$
MATRIX_SELECTOR_RATING_PROMPT=^Rate this lesson$
MATRIX_SELECTOR_RATING=^(?:Rate this lesson|Rate [123]|Your rating \([123]\) is queued to send\.|Your rating \([123]\) was accepted\.|A rating exists, but server acceptance cannot be verified\.|Rating is unavailable for this receipt\.|Rating was not saved\. Try again\.|Send queued rating)$
