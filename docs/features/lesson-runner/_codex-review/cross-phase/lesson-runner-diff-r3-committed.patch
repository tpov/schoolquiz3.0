+                .setConstraints(
+                    Constraints.Builder()
+                        .setRequiredNetworkType(NetworkType.CONNECTED)
+                        .build()
+                )
+                .build()
+        )
+        // Bootstrap one-shot sync: runs ONCE after install (first-ever launch).
