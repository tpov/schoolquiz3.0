<?xml version="1.0" encoding="utf-8"?>
<!-- Copy of src/mvp/AndroidManifest.xml: the mvpb source set is NOT merged with src/mvp
     (initWith only inherits build config, not sources), so the second isolated client
     must re-declare the cleartext network security config to reach the demo rig at
     204.44.66.27 — see docs/agents/evidence/2026-10-31-devicefarm-426-proposals. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:label="School Quiz · MVP test B"
        android:networkSecurityConfig="@xml/mvp_network_security_config"
        tools:replace="android:label">
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_performance_collection_deactivated" android:value="true" />
    </application>
</manifest>
