rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Privilege fields are server-write only (Cloud Functions / Admin SDK).
      // diff().affectedKeys() checks only fields being changed, so legitimate
      // owner updates (nickname, currentSkill, etc.) pass through.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['admin', 'developer', 'moderator', 'tester', 'sponsor', 'translater']));
    }

    match /quizzes/{userId}/{rest=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('ratingGlobal' in request.resource.data)
        && !('ratingLocal' in request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ratingGlobal', 'ratingLocal']));
    }
  }
}
