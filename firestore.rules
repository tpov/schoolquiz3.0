rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Server-owned. This document is the balance sheet: currency, life points, qualifications.
      //
      // It used to be owner-writable with a denylist of privilege fields, which left lifePoints,
      // gold, nolics, skillPoints and standardHearts open — a player could grant themselves any
      // balance with a plain SDK call and bypass every server-side check, score verification
      // included. A denylist also silently admits each new field somebody adds later.
      //
      // Offline play does not need this: results queue in the local outbox and are settled by
      // submitLessonResultEvents, purchases by applyShopPurchase, boxes by openGiftBox. The client
      // only ever reads here (FirebaseUserStatsDataSource), so nothing legitimate is lost.
      allow write: if false;
    }

    match /nickname_claims/{claimId} {
      // Server-owned unique nickname registry. Clients use updateUserNickname callable.
      allow read, write: if false;
    }

    match /configs/{configId} {
      // Server-owned runtime configs, including configs/nickname_policy.
      allow read, write: if false;
    }

    match /profiles/{userId} {
      // Trusted profile mirror used by server-side review routing. Clients can read
      // their own profile, but never write qualification fields here.
      allow read: if request.auth != null && (request.auth.uid == userId || isReviewer());
      allow write: if false;
    }

    match /private/{userId}/{document=**} {
      // Private authored hierarchy: private/{uid}/catalogs/{catalogId}/quests/... .
      // It is server-written from quest_review_requests; the owner can read it.
      allow read: if request.auth != null && (request.auth.uid == userId || isReviewer());
      allow write: if false;
    }

    match /admin/{document=**} {
      // Admin review hierarchy: admin/review/lessons/{lessonId}/quests/{questId}/questions/{questionId}.
      // Reviewers can read only if their trusted profile has the required qualification.
      allow read: if isReviewer();
      allow write: if false;
    }

    match /quest_review_requests/{requestId} {
      // Client only creates an outbox request. Processing/copying is server-only.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.processed == false;
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isReviewer());
      allow update, delete: if false;
    }

    match /catalogs/{catalogId} {
      // Public read — catalogs are static categories shown to all users incl. guests.
      allow read: if true;
      allow write: if isAdmin();

      // Tiny per-catalog change records used by offline-first sync.
      // Real content is still read from the flat collections below by document ID.
      // Admin/backfill tooling must only place public catalog content here.
      match /sync_changes/{changeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /quests/{questId} {
      allow read: if resource.data.visibleOn.size() > 0
        || (request.auth != null && resource.data.authorUid == request.auth.uid);

      // Author can create own quests; coarse field allowlist prevents arbitrary field injection.
      // MVP: field list coarse check; strict value validation for rating/lastModifiedAt deferred.
      // Post-MVP: Cloud Function validates rating bounds + server timestamps.
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'id', 'catalogId', 'authorUid', 'title', 'description',
             'picturePath', 'visibleOn', 'archived',
             'version', 'contentsVersion', 'lastModifiedAt',
             'averageRating', 'averageRatingCount'
           ])
        && request.resource.data.version == 1
        && request.resource.data.contentsVersion == 0
        && !request.resource.data.keys().hasAny(['averageRating', 'averageRatingCount']);

      // Author can update only user-owned fields; server-managed and immutable fields blocked.
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'picturePath', 'visibleOn', 'archived', 'catalogId']);

      // Delete is admin-only (quest CRUD MVP placeholder; full delete flow is future work).
      allow delete: if isAdmin();
    }

    // Nested content — MVP security posture (Option C, see ADR in 03-decisions.md):
    // Any client can read sections/themes/lessons/questions directly by document ID.
    // Quest-level visibility enforcement (authorUid / visibleOn) is applied by the sync
    // orchestrator client-side: only quests visible to the user are synced, and their
    // descendants are fetched only as part of that quest's subtree cascade.
    // Direct reads of nested content are not guarded at Firestore level to avoid
    // expensive parent-lookup get() calls on every read. Accepted MVP trade-off;
    // post-MVP: denormalize questAuthorUid + questIsPublic into nested documents (Option B).
    match /sections/{sectionId}   { allow read: if true; allow write: if isAdmin(); }
    match /themes/{themeId}       { allow read: if true; allow write: if isAdmin(); }
    match /lessons/{lessonId}     { allow read: if true; allow write: if isAdmin(); }
    match /questions/{questionId} { allow read: if true; allow write: if isAdmin(); }

    match /lesson_content/{lessonId} {
      match /sync_changes/{changeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /tournaments/{tournamentId} {
      // Tournament tables are server-written from lesson result events.
      // Authenticated clients may read public standings and participant lists.
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    function isAdmin() {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.adminLevel >= 100
        )
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.qualifications.admin >= 100
        )
      );
    }

    function isReviewer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.developerLevel > 100
          || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.testerLevel >= 100
          || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.adminLevel >= 100
          || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.translatorLevel >= 100
        );
    }
  }
}
