<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#666666"/> <!-- Same as placeholder: Medium-light gray -->
            <corners android:radius="@dimen/referral_item_corner_radius"/>
        </shape>
    </item>

    <!-- Progress fill -->
    <item android:id="@android:id/progress">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/referral_progress_fill_dark_green"/> <!-- Dark green for fill -->
                <corners android:radius="@dimen/referral_item_corner_radius"/>
            </shape>
        </clip>
    </item>

</layer-list>
