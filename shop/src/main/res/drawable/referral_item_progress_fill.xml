<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background of the progress bar -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/back_item"/> <!-- e.g., #191919 -->
            <stroke android:color="#444444" android:width="1dp"/> <!-- Neutral subtle border -->
            <corners android:radius="@dimen/referral_item_corner_radius"/> <!-- 8dp -->
        </shape>
    </item>

    <!-- Progress -->
    <item android:id="@android:id/progress">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/back_main_green_progress"/> <!-- Define this color, e.g., a vibrant green -->
                <corners android:radius="@dimen/referral_item_corner_radius"/>
            </shape>
        </clip>
    </item>

</layer-list>
