<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Enhanced base application theme with layering -->
    <style name="Theme.Schoolquiz" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorPrimaryVariant">@color/app_accent_dark</item>
        <item name="colorOnPrimary">@color/app_text_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/app_highlight_text</item>
        <item name="colorSecondaryVariant">@color/app_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Enhanced status bar color -->
        <item name="android:statusBarColor">@color/app_background_dark</item>
        <!-- Enhanced background colors with layering -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background_dark</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <!-- System UI -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Enhanced Shop module theme with layering -->
    <style name="Theme.ShopModule" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorPrimaryDark">@color/app_background_dark</item>
        <item name="colorAccent">@color/app_gold</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background_dark</item>
        <item name="android:navigationBarColor">@color/app_background_dark</item>
        <!-- Card styles -->
        <item name="cardViewStyle">@style/ShopCardViewStyle</item>
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/ShopButtonPrimary</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <!-- System UI -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    

    
    <!-- Fullscreen theme for ReferralActivity -->
    <style name="Theme.ShopModule.Fullscreen" parent="Theme.ShopModule">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>