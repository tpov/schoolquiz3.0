<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Schoolquiz" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorPrimaryVariant">@color/app_accent_dark</item>
        <item name="colorOnPrimary">@color/app_text_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/app_highlight_text</item>
        <item name="colorSecondaryVariant">@color/app_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/app_background_dark</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
    </style>

    <!-- Base application theme for the Shop module -->
    <style name="Theme.ShopModule" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorPrimaryDark">@color/app_background_dark</item>
        <item name="colorAccent">@color/app_gold</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Card styles -->
        <item name="cardViewStyle">@style/AppCardStyle</item>
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
    </style>
    
    <!-- Fullscreen theme for ReferralActivity -->
    <style name="Theme.ShopModule.Fullscreen" parent="Theme.ShopModule">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>