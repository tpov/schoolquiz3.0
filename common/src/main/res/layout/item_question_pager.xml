<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="8dp">

    <!-- Блок с вопросом -->
    <LinearLayout
        android:id="@+id/ll_show_question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/back_item_main_unable"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/ll_answers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imv_photo_question"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <EditText
            android:id="@+id/tv_question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:elevation="10dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:hint="Введите текст вопроса"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:minLines="2"
            android:maxLines="4" />
    </LinearLayout>

    <!-- Блок с ответами -->
    <LinearLayout
        android:id="@+id/ll_answers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/button_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/back_item_main"
            android:elevation="20dp"
            android:gravity="center"
            android:minHeight="50dp"
            android:padding="16dp"
            android:hint="Ответ 1"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/button_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/back_item_main"
            android:elevation="10dp"
            android:gravity="center"
            android:minHeight="50dp"
            android:padding="16dp"
            android:hint="Ответ 2"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/button_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/back_item_main"
            android:elevation="10dp"
            android:gravity="center"
            android:minHeight="50dp"
            android:padding="16dp"
            android:hint="Ответ 3"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/button_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/back_item_main"
            android:elevation="10dp"
            android:gravity="center"
            android:minHeight="50dp"
            android:padding="16dp"
            android:hint="Ответ 4"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
